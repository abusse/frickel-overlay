src_prepare() {
	default
}

src_install() {
	cargo_src_install

	# Install example config
	insinto /etc/govee2mqtt
	doins addon/config.yaml

	# Install OpenRC init script
	newinitd "${FILESDIR}/govee2mqtt.initd" govee2mqtt
}

pkg_postinst() {
	elog "Govee2MQTT installed."
	elog "Copy and edit /etc/govee2mqtt/config.yaml before starting:"
	elog "  cp /etc/govee2mqtt/config.yaml.example /etc/govee2mqtt/config.yaml"
	elog "  nano /etc/govee2mqtt/config.yaml"
	elog ""
	elog "Start service with:"
	elog "  rc-service govee2mqtt start"
	elog "Enable at boot:"
	elog "  rc-update add govee2mqtt default"
}
